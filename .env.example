# Express API address (the velora-server project)
API_URL=http://localhost:5000

# MongoDB, used by Better Auth for users, sessions and accounts
MONGODB_URI=
DB_NAME=velora

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Must match JWT_SECRET on the server. Signs the token the Express API verifies.
JWT_SECRET=

# Google OAuth (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
